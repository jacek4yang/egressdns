# Build artefacts
/target
/dist
**/*.rs.bk

# Python bytecode from the bundled load generator
__pycache__/
*.py[cod]

# Fuzzing
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
/fuzz/coverage

# Local state produced by running the daemon out of the source tree
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.corrupt-*
/cloudflare-prefixes.json

# Benchmark output
/criterion

# Editor and OS noise
.DS_Store
*.swp
.idea/
.vscode/

# Generated by scripts/build-source-archive.sh; a committed copy is guaranteed stale.
MANIFEST.sha256
